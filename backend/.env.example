# ============================================================
# 智能数仓平台 · 真实环境配置模板
# 用法：复制本文件为 backend/.env 后，按需替换其中的连接串与密钥。
#   （本地开发直跑已内置在 backend/.env，切真环境只需改 backend/.env）
# 所有配置项均与 backend/app/config.py 一一对应。
# ============================================================

# ---------- 应用基础 ----------
APP_NAME=智能数仓平台
APP_HOST=127.0.0.1
APP_PORT=8000
# True=开发调试(自动 reload)；生产建议 False
DEBUG=true

# ---------- 数据库（二选一） ----------
# 开发默认 SQLite（无需服务，开箱即用）：
#   DB_URL=sqlite:///./smart_dw.db
# 生产/联真环境 MySQL 8.0（务必 utf8mb4）：
DB_URL=mysql+pymysql://<用户名>:<密码>@<主机>:3306/smart_dw?charset=utf8mb4
# 建表可复用 docker/init/init.sql（对应 Spec §2 全量表）。

# ---------- Redis / Celery ----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 任务执行模式：
#   dev —— 同步执行，无需 Redis，本地开发用
#   prod —— 走 Celery 队列，需要上述 Redis 三连
TASK_MODE=dev

# ---------- Elasticsearch（可选，不可用自动回退 SQL 检索） ----------
ES_URL=http://127.0.0.1:9200
ES_INDEX_META=meta_index
# false=禁用 ES 直接用 SQL；true=启用（需 ES_URL 可达）
ES_ENABLED=false

# ---------- Spark (3.X) ----------
SPARK_MASTER=local[*]
SPARK_SUBMIT_CONF=--driver-memory 2g --executor-memory 2g

# ---------- 千问 Qwen LLM 网关（NL2SQL / 口径问答） ----------
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3-8b
# 仅服务端加密存储，前端任何环节不回传。拿到真实 Key 后替换：
QWEN_API_KEY=sk-REPLACE_WITH_REAL_KEY
QWEN_TIMEOUT=30
QWEN_MAX_RETRY=2
# true=LLM 不可达时自动回退规则生成，保证功能不中断
QWEN_FALLBACK_ENABLED=true

# ---------- 加密主密钥 / JWT ----------
# AES-GCM 派生用，至少 32 字节随机串，泄漏需重置(会造成已存 Key 无法解密)
LLM_KEY_ENC_MASTER=REPLACE_WITH_A_RANDOM_32BYTE_SECRET_LONG
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 元数据 / 账号 ----------
# 元数据本地建表文件目录（/metadata/sync?source=file 采集时读取 .hql/.sql）
METADATA_FILE_DIR=./sample_ddls
# 简化认证下的默认开发者工号
DEFAULT_EMPLOYEE_NO=1207799